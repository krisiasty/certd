[Unit]
Description=certd - Self-signed certificate generation and management
Documentation=https://github.com/krisiasty/certd
After=network-online.target
Wants=network-online.target

# Give up after repeated failures rather than restarting forever. RestartSec
# below spaces restarts ten seconds apart, so systemd's default limit of five
# starts within ten seconds can never be reached: without these, a permanently
# failing certd would restart every ten seconds indefinitely and never enter the
# failed state that monitoring looks for.
# StartLimitIntervalSec and StartLimitBurst belong to [Unit]; systemd moved them
# out of [Service] in v229 and warns if they are set there.
StartLimitIntervalSec=300
StartLimitBurst=5

# Certificate notification path units are opt-in.
# See the README for certd-notify-<algorithm>@<service>.path usage.

[Service]
Type=notify
NotifyAccess=main
User=certd
Group=certd

# Directory for certificates - default: /var/lib/certd
StateDirectory=certd
StateDirectoryMode=0750

# Directory for notification files - default: /run/certd
RuntimeDirectory=certd
RuntimeDirectoryMode=0750

# Default configuration - override any of these in a drop-in snippet:
# /etc/systemd/system/certd.service.d/override.conf
Environment=CERTD_ED25519=false
Environment=CERTD_ECDSA=true
Environment=CERTD_RSA=false
Environment=CERTD_LIFETIME=1y
Environment=CERTD_CERT_DIR=%S/certd
Environment=CERTD_NOTIFY_DIR=%t/certd
Environment=CERTD_INTERNAL_IP=true
Environment=CERTD_EXTERNAL_IP=true
Environment=CERTD_POLL_INTERVAL=5m
Environment=CERTD_MAX_RETRIES=5
Environment=CERTD_HTTP_ADDR=127.0.0.1:8484

# limit the number of OS threads used
Environment=GOMAXPROCS=1

ExecStart=/usr/local/bin/certd

Restart=on-failure
RestartSec=10
TimeoutStartSec=3min

# --- Hardening ---

# Prevent privilege escalation
NoNewPrivileges=yes

# Kernel security
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=no

# Filesystem restrictions — certd only needs its own dirs and /run
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

# Restrict /proc and /sys visibility
ProcSubset=pid
ProtectProc=invisible

# Device access
PrivateDevices=yes

# Network — certd needs AF_UNIX to notify systemd and outbound HTTP for
# external IP detection
# Remove PrivateNetwork so it can reach external IP providers and
# the host network for internal IP detection
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# System call filtering — allow only what certd needs
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot
SystemCallArchitectures=native

# Capabilities — certd runs as unprivileged user, needs none
CapabilityBoundingSet=
AmbientCapabilities=

# Misc
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
UMask=0027

[Install]
WantedBy=multi-user.target
